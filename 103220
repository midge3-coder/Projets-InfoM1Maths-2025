    "param_dist = {\n",
    "        'C': uniform(0.1, 10),  # Distribution uniforme entre 0.1 et 10\n",
    "        'gamma': ['scale', 'auto'] + list(np.logspace(-3, 1, 5)),\n",
    "        'kernel': ['rbf', 'linear', 'poly'],\n",
    "        'degree': [2, 3, 4],  # Pour poly seulement\n",
    "        'coef0': uniform(0, 1),  #\n",
    "    }\n",
    "    \n",
    "svm = SVC(probability=False, random_state=42)\n",
    "    \n",
    "# RandomizedSearchCV\n",
    "random_search3 = RandomizedSearchCV(\n",
    "        estimator=svm,\n",
    "        param_distributions=param_dist,\n",
    "        n_iter=50,  # Nombre d'itérations de la recherche aléatoire\n",
    "        cv=5,\n",
    "        n_jobs=-1, \n",
    "        scoring='accuracy',\n",
    "        random_state=42,\n",
    "        verbose=0\n",
    "    )\n",
    "    \n",
    "random_search3.fit(X_train, Y_train)\n",
    "print(f\"Meilleurs paramètres: {random_search3.best_params_}\")\n",
    "print(f\"Meilleur score: {random_search3.best_score_:.4f}\")\n",
    "# Évaluation sur le test\n",
    "best_svm = random_search3.best_estimator_\n",
    "Y_pred = best_svm.predict(X_test)\n",
    "    \n",
    "print(f\"\\nPerformance sur l'ensemble de test :\")\n",
    "print(f\"Accuracy : {accuracy_score(Y_test, Y_pred):.4f}\")\n",
    "print(f\"F1-score : {f1_score(Y_test, Y_pred):.4f}\")\n",
    "random_search3"
