    "# Recherche des hyperparamètres\n",
    "param_grid = {\n",
    "        'hidden_layer_sizes': [(50,), (100,), (50, 50), (100, 50), (100, 100)],\n",
    "        'activation': ['relu', 'tanh', 'logistic'],\n",
    "        'alpha': [0.0001, 0.001, 0.01, 0.1],\n",
