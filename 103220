    "        'learning_rate_init': [0.001, 0.01],\n",
    "        'max_iter': [500, 1000, 1500],\n",
    "        'solver': ['adam', 'sgd']\n",
    "    }\n",
    "    \n",
    "mlp = MLPClassifier(random_state=42, early_stopping=True)\n",
    "    \n",
    "# RandomizedSearchCV\n",
    "random_search2 = RandomizedSearchCV(\n",
    "        mlp, param_distributions=param_grid,\n",
    "        n_iter=30, cv=5, scoring='f1',\n",
